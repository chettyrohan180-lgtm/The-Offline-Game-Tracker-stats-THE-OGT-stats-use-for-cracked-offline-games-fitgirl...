{
  "name": "ogt-offline-game-tracker",
  "version": "1.0.0",
  "description": "Offline Game Tracker (OGT) for Windows - Track playtime, sessions, and achievements",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron": "set NODE_ENV=development && node_modules\\.bin\\electron . --dev",
    "electron-dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && set NODE_ENV=development && node_modules\\.bin\\electron . --dev\"",
    "start": "node_modules\\.bin\\electron .",
    "build": "vite build"
  },
  "keywords": [
    "game-tracker",
    "offline-games",
    "steam-emulator",
    "playtime",
    "achievements"
  ],
  "author": "OGT Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^28.2.0",
    "vite": "^5.0.12",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.21.5": true
  }
}
